# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)
# Source Operational Database (MySQL / PostgreSQL)
SOURCE_DB_TYPE=mysql
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=your_secure_password_here
SOURCE_DB_NAME=grammy_source_db

# Analytical Data Warehouse (MySQL / PostgreSQL)
DW_DB_TYPE=mysql
DW_DB_HOST=127.0.0.1
DW_DB_PORT=3306
DW_DB_USER=root
DW_DB_PASSWORD=your_secure_password_here
DW_DB_NAME=music_dw

# Data Paths
SPOTIFY_CSV_PATH=spotify_dataset.csv
GRAMMY_CSV_PATH=the_grammy_awards.csv
DATA_DIR=data
EVIDENCE_DIR=docs/evidence

# Apache Airflow Configuration
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
